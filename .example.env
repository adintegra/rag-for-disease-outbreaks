# Neon or PostgreSQL connection. Standard postgresql:// Neon URLs are normalized to psycopg3.
DATABASE_URL="postgresql://user:CHANGEME@host/database?sslmode=require"
# Optional direct (unpooled) connection for Alembic migrations.
# DATABASE_URL_DIRECT="postgresql://user:CHANGEME@host/database?sslmode=require"

OLLAMA_BASE_URL="http://localhost:11434"

# Local OpenAI-compatible generation endpoint (for example LM Studio)
LLM_BASE_URL="http://localhost:1234/v1"
LLM_API_KEY="lm-studio"
LLM_MODEL="llama3.2"
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
RAG_CONTEXT_MAX_CHARACTERS=12000
RAG_QUERY_MAX_CHARACTERS=1000
RAG_RETRIEVAL_PROFILE="sections"
HTTP_MAX_BODY_BYTES=16384
MAX_CONCURRENT_GENERATIONS=2

#LLM="phi4"  # 15B / num_ctx 16384
#LLM="deepseek-r1"  # 7B / num_ctx 131072
#LLM="qwen2.5max_ctx"  # 7B / num_ctx 32768

# LOGS = true  # Uncomment to enable logging

CURRENT_BATCH=1
EMBEDDING_PROVIDER="openai_compatible"
EMBEDDING_BASE_URL="http://localhost:1234/v1"
EMBEDDING_API_KEY="lm-studio"
EMBEDDING_MODEL="text-embedding-all-minilm-l6-v2-embedding"
# Change this when the model artifact behind a mutable identifier changes.
EMBEDDING_MODEL_VERSION="text-embedding-all-minilm-l6-v2-embedding"
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_REQUEST_TIMEOUT_SECONDS=120

WHO_REQUEST_TIMEOUT_SECONDS=30
WHO_PAGE_SIZE=20
INGESTION_SOURCE="who_don"
INGESTION_BATCH_SIZE=100
LOG_LEVEL="INFO"

# Machine endpoint authentication. This key is never rendered into the browser.
REQUIRE_API_KEY=false
# API_KEY="replace-with-a-secret"

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="xxxx"
LANGSMITH_PROJECT="don-rag-ingestion"
# Full chunk text is excluded from embedding traces unless explicitly enabled.
LANGSMITH_TRACE_CONTENT=false
LANGSMITH_TRACE_QUERY=false

RAGAS_APP_TOKEN = "xxxx"
RAGAS_DO_NOT_TRACK = true

OPENAI_API_KEY = "xxxx"
NOMIC_API_KEY = "xxxx"
GROQ_API_KEY = "xxxx"
