# psycopg3 for langchain
CONNECTION_STRING = "postgresql+psycopg://postgres:CHANGEME@localhost:5432"

OLLAMA_BASE_URL = "http://localhost:11434"

LLM="llama3.2"  # 3B / num_ctx 131072
#LLM="phi4"  # 15B / num_ctx 16384
#LLM="deepseek-r1"  # 7B / num_ctx 131072
#LLM="qwen2.5max_ctx"  # 7B / num_ctx 32768

# LOGS = true  # Uncomment to enable logging

CURRENT_BATCH = 1
EMBEDDING_MODEL = "all-minilm"

# Optional: require X-API-Key on POST /search when exposing Flask publicly
# API_KEY = "CHANGEME"

LANGSMITH_TRACING = false
LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"
LANGSMITH_API_KEY = "xxxx"
LANGSMITH_PROJECT = "xxxx"

RAGAS_APP_TOKEN = "xxxx"
RAGAS_DO_NOT_TRACK = true

OPENAI_API_KEY = "xxxx"
NOMIC_API_KEY = "xxxx"
GROQ_API_KEY = "xxxx"
