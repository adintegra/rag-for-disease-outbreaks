# Neon or PostgreSQL connection. Standard postgresql:// Neon URLs are normalized to psycopg3.
DATABASE_URL="postgresql://user:CHANGEME@host/database?sslmode=require"
# Optional direct (unpooled) connection for Alembic migrations.
# DATABASE_URL_DIRECT="postgresql://user:CHANGEME@host/database?sslmode=require"

OLLAMA_BASE_URL = "http://localhost:11434"

LLM="llama3.2"  # 3B / num_ctx 131072
#LLM="phi4"  # 15B / num_ctx 16384
#LLM="deepseek-r1"  # 7B / num_ctx 131072
#LLM="qwen2.5max_ctx"  # 7B / num_ctx 32768

# LOGS = true  # Uncomment to enable logging

CURRENT_BATCH=1
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="all-minilm"
EMBEDDING_DIMENSIONS=384

WHO_REQUEST_TIMEOUT_SECONDS=30
WHO_PAGE_SIZE=20
INGESTION_SOURCE="who_don"
INGESTION_BATCH_SIZE=100
LOG_LEVEL="INFO"

# Optional: require X-API-Key on POST /search when exposing Flask publicly
# API_KEY = "CHANGEME"

LANGSMITH_TRACING = false
LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"
LANGSMITH_API_KEY = "xxxx"
LANGSMITH_PROJECT = "xxxx"

RAGAS_APP_TOKEN = "xxxx"
RAGAS_DO_NOT_TRACK = true

OPENAI_API_KEY = "xxxx"
NOMIC_API_KEY = "xxxx"
GROQ_API_KEY = "xxxx"
